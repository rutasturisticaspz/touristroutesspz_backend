# ------------------------------------------------------------
#  Backend — copie este archivo como .env
#
#  Sólo lo que necesita el backend. El sitio público tiene su propio
#  frontend/.env.local, y docker compose el suyo en la raíz.
#
#  TODO corre en localhost. No hay configuración de servidores.
# ------------------------------------------------------------

PORT=2999
NODE_ENV=development

# Base de datos.
#
# Para "npm run dev" en local: 127.0.0.1, como está abajo.
#
# Para "docker compose" de la raíz (desarrollo local, con su propio
# contenedor de MySQL): ese compose reemplaza esta variable y el host
# pasa a ser "db".
#
# Para "backend/docker-compose.yml" (despliegue en el servidor de la
# Universidad, con la base corriendo en su propio contenedor en la
# misma máquina, ver ../db/docker-compose.yml): el host es el nombre
# del contenedor de esa base, "rutas-db", y las credenciales son las
# reales que se pusieron en db/.env, no root/local. Por ejemplo:
#     DATABASE_URL="mysql://rutas:LA_PASSWORD_REAL@rutas-db:3306/db_rutas_turisticas"
DATABASE_URL="mysql://rutas:local@127.0.0.1:3306/db_rutas_turisticas"

# Firma de los tokens de sesión.
# Genere el valor con:
#     cd backend && npm run generar-secreto
# Es la llave con la que se firman los tokens de sesion. Si cambia,
# todas las sesiones abiertas dejan de valer. Nunca se sube al
# repositorio.
JWT_SECRET=
JWT_EXPIRATION=10h

# Carpeta donde se guardan las imágenes subidas
UPLOADS_DIR=uploads

# Origen del sitio público, para CORS
CORS_ORIGIN=http://localhost:3000

# --- Solo para "docker compose" DESDE ESTA CARPETA (despliegue) ---
# No lo usa "npm run dev": ahi las imagenes se leen directo de
# UPLOADS_DIR en este disco.
#
# UPLOADS_HOST_PATH es la ruta, en la maquina del servidor, donde el
# admin de la U monta el volumen con las imagenes -- las 1587 fotos
# NO viajan dentro de este repo, se le entregan aparte y el las deja
# en la ruta que el ya tenga preparada para eso. Adentro del
# contenedor esa ruta siempre se ve como /app/uploads, sin importar
# cual sea la de aqui abajo.
#
# CAMBIE el valor de abajo por la ruta real que le de el admin del
# servidor, por ejemplo:
#     UPLOADS_HOST_PATH=/var/data/rutas-turisticas/uploads
UPLOADS_HOST_PATH=/ruta/que/le/de/el/admin/del/servidor
# ------------------------------------------------------------
#  Correo saliente (SMTP) — opcional
#
#  Sin esto, el sistema funciona igual; solo "Responder por correo"
#  en /admin/mensajes falla al usarse, con un aviso claro.
#
#  Pensado para una cuenta institucional. Dos formas comunes de
#  conseguir estos datos:
#
#  a) SMTP propio de la Universidad (pregunte a TI de la UNA si
#     existe uno para dependencias/proyectos). Le darían host, puerto,
#     usuario y contraseña directamente.
#
#  b) Una cuenta de Google Workspace (por ejemplo, la institucional
#     de rutas turísticas) usando el SMTP de Gmail. Ahí SMTP_USER es
#     el correo completo, y SMTP_PASSWORD NO es la contraseña normal
#     de la cuenta —Google no lo permite—, sino una "contraseña de
#     aplicación" que se genera en la configuración de seguridad de
#     esa cuenta (requiere verificación en dos pasos activada).
#
#  Nunca suba este archivo con las credenciales reales; solo
#  backend/.env (que no se sube a git).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Si se deja vacío, se usa SMTP_USER como remitente.
SMTP_FROM=
