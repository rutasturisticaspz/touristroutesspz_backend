}

model OperadoresTuristicosContactos {
  operadoresTuristicosId Int
  contactosId            Int

  operador OperadoresTuristicos @relation(fields: [operadoresTuristicosId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FK_8af59eba939cf043966cda6b401")
  contacto Contactos            @relation(fields: [contactosId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FK_55edcc8427b39b606d861aa0ab0")

  @@id([operadoresTuristicosId, contactosId])
  @@index([operadoresTuristicosId], map: "IDX_8af59eba939cf043966cda6b40")
  @@index([contactosId], map: "IDX_55edcc8427b39b606d861aa0ab")
