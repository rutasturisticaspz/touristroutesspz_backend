  descripcionIngles      String  @db.Text
  discapacidadVisual     Boolean @default(false) @db.TinyInt
  discapacidadAuditiva   Boolean @default(false) @db.TinyInt
  discapacidadFisica     Boolean @default(false) @db.TinyInt
  discapacidadCognitiva  Boolean @default(false) @db.TinyInt
  discapacidadSicosocial Boolean @default(false) @db.TinyInt

  discapacidadVisualDescripcion           String? @db.Text
  discapacidadVisualDescripcionIngles     String? @db.Text
  discapacidadAuditivaDescripcion         String? @db.Text
  discapacidadAuditivaDescripcionIngles   String? @db.Text
  discapacidadFisicaDescripcion           String? @db.Text
  discapacidadFisicaDescripcionIngles     String? @db.Text
  discapacidadCognitivaDescripcion        String? @db.Text
  discapacidadCognitivaDescripcionIngles  String? @db.Text
  discapacidadSicosocialDescripcion       String? @db.Text
  discapacidadSicosocialDescripcionIngles String? @db.Text

  ubicacion Ubicaciones? @relation(fields: [ubicacionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_01037fa45d53750b6b88b3bab2e")

  imagenes  ImagenesOperadoresTuristicos[]
  contactos OperadoresTuristicosContactos[]
  eventos   EventosOperadores[]

  @@index([ubicacionId], map: "FK_01037fa45d53750b6b88b3bab2e")
