}

model ImagenesOperadoresTuristicos {
  id                  Int       @id @default(autoincrement())
  nombre              String    @db.Text
  descripcion         String?   @db.Text
  url                 String    @db.Text
  nameUrl             String    @db.Text
  state               String    @default("Active") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @db.Timestamp(6)
  updateAt            DateTime? @db.Timestamp(0)
  operadorTuristicoId Int?

  operador OperadoresTuristicos? @relation(fields: [operadorTuristicoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a495ebc0a9a02901df63bc5e491")

  @@index([operadorTuristicoId], map: "FK_a495ebc0a9a02901df63bc5e491")
