// ------------------------------------------------------------
//  Rentadoras de vehículos
// ------------------------------------------------------------

model RentadorasVehiculos {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.Text
  descripcion String    @db.Text
  state       String    @default("Active") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updateAt    DateTime? @db.Timestamp(0)
  ubicacionId Int?

  descripcionIngles      String  @db.Text
  discapacidadVisual     Boolean @default(false) @db.TinyInt
  discapacidadAuditiva   Boolean @default(false) @db.TinyInt
  discapacidadFisica     Boolean @default(false) @db.TinyInt
  discapacidadCognitiva  Boolean @default(false) @db.TinyInt
  discapacidadSicosocial Boolean @default(false) @db.TinyInt

  discapacidadVisualDescripcion           String? @db.Text
  discapacidadVisualDescripcionIngles     String? @db.Text
  discapacidadAuditivaDescripcion         String? @db.Text
  discapacidadAuditivaDescripcionIngles   String? @db.Text
  discapacidadFisicaDescripcion           String? @db.Text
  discapacidadFisicaDescripcionIngles     String? @db.Text
  discapacidadCognitivaDescripcion        String? @db.Text
  discapacidadCognitivaDescripcionIngles  String? @db.Text
  discapacidadSicosocialDescripcion       String? @db.Text
  discapacidadSicosocialDescripcionIngles String? @db.Text

  ubicacion Ubicaciones? @relation(fields: [ubicacionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_addce49626c69818e9698ec19a6")

  imagenes  ImagenesRentadorasVehiculos[]
  contactos RentadorasVehiculosContactos[]
  eventos   EventosRentadoras[]

  @@index([ubicacionId], map: "FK_addce49626c69818e9698ec19a6")
  @@map("rentadoras_vehiculos")
}

model ImagenesRentadorasVehiculos {
  id                   Int       @id @default(autoincrement())
  nombre               String    @db.Text
  descripcion          String?   @db.Text
  url                  String    @db.Text
  nameUrl              String    @db.Text
  state                String    @default("Active") @db.VarChar(255)
  createdAt            DateTime  @default(now()) @db.Timestamp(6)
  updateAt             DateTime? @db.Timestamp(0)
  rentadoraVehiculosId Int?

  rentadora RentadorasVehiculos? @relation(fields: [rentadoraVehiculosId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8b3b613e62349cf6da3dad04d9a")

  @@index([rentadoraVehiculosId], map: "FK_8b3b613e62349cf6da3dad04d9a")
  @@map("imagenes_rentadoras_vehiculos")
}

model RentadorasVehiculosContactos {
  rentadorasVehiculosId Int
  contactosId           Int

  rentadora RentadorasVehiculos @relation(fields: [rentadorasVehiculosId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FK_91315dfe359baa14665935565bc")
  contacto  Contactos           @relation(fields: [contactosId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FK_0f811d2caaf375ed4d8fc25b6a7")

  @@id([rentadorasVehiculosId, contactosId])
  @@index([rentadorasVehiculosId], map: "IDX_91315dfe359baa14665935565b")
  @@index([contactosId], map: "IDX_0f811d2caaf375ed4d8fc25b6a")
  @@map("rentadoras_vehiculos_contactos_contactos")
}

// ------------------------------------------------------------
//  Rutas turísticas (personalizadas por usuario)
// ------------------------------------------------------------

model RutasTuristicas {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.Text
  state     String    @default("Active") @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updateAt  DateTime? @db.Timestamp(0)
  usuarioId Int?

  usuario Usuarios? @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_db80f47a037a849dfb7b4d940ed")

  atracciones RutasTuristicasAtracciones[]

  @@index([usuarioId], map: "FK_db80f47a037a849dfb7b4d940ed")
  @@map("rutas_turisticas")
}

model RutasTuristicasAtracciones {
  rutasTuristicasId Int
  atraccionesId     Int

  ruta      RutasTuristicas @relation(fields: [rutasTuristicasId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FK_e8c5d41e5f3ae4b36417731e570")
  atraccion Atracciones     @relation(fields: [atraccionesId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FK_7959656f847a86fa9c075c5dc02")

  @@id([rutasTuristicasId, atraccionesId])
  @@index([rutasTuristicasId], map: "IDX_e8c5d41e5f3ae4b36417731e57")
  @@index([atraccionesId], map: "IDX_7959656f847a86fa9c075c5dc0")
  @@map("rutas_turisticas_atracciones_atracciones")
}
