  descripcion String?   @db.Text @map("imagenes_rentadoras_vehiculos_descripcion")
  url String    @db.Text @map("imagenes_rentadoras_vehiculos_url")
  nameUrl String    @db.Text @map("imagenes_rentadoras_vehiculos_name_url")
  state String    @default("Active") @db.VarChar(255) @map("imagenes_rentadoras_vehiculos_state")
  createdAt DateTime  @default(now()) @db.Timestamp(6) @map("imagenes_rentadoras_vehiculos_created_at")
  updateAt DateTime? @db.Timestamp(0) @map("imagenes_rentadoras_vehiculos_update_at")
  rentadoraVehiculosId Int? @map("imagenes_rentadoras_vehiculos_rentadora_vehiculos_id")

  rentadora RentadorasVehiculos? @relation(fields: [rentadoraVehiculosId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8b3b613e62349cf6da3dad04d9a")

  @@index([rentadoraVehiculosId], map: "FK_8b3b613e62349cf6da3dad04d9a")
  @@map("PZR_imagenes_rentadoras_vehiculos")
}

model RentadorasVehiculosContactos {
