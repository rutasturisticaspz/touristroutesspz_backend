//  baselining no genere deriva.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  Catálogos base
// ------------------------------------------------------------

model Usuarios {
  id Int       @id @default(autoincrement()) @map("usuariosrutas_id")
  nombre String?   @db.Text @map("usuariosrutas_nombre")
  email String?   @db.Text @map("usuariosrutas_email")
  password String?   @db.Text @map("usuariosrutas_password")
  state String    @default("Active") @db.VarChar(255) @map("usuariosrutas_state")
  rol String?   @db.Text @map("usuariosrutas_rol")
  createdAt DateTime  @default(now()) @db.Timestamp(6) @map("usuariosrutas_created_at")
  updateAt DateTime? @db.Timestamp(0) @map("usuariosrutas_update_at")

  calificaciones  Calificaciones[]
  rutasTuristicas RutasTuristicas[]

  @@map("PZR_usuariosrutas")
}

model Categorias {
  id Int       @id @default(autoincrement()) @map("categorias_id")
  nombre String    @db.Text @map("categorias_nombre")
  descripcion String    @db.Text @map("categorias_descripcion")
  state String    @default("Active") @db.VarChar(255) @map("categorias_state")
  createdAt DateTime  @default(now()) @db.Timestamp(6) @map("categorias_created_at")
  updateAt DateTime? @db.Timestamp(0) @map("categorias_update_at")
  nombreIngles String    @db.Text @map("categorias_nombre_ingles")
  descripcionIngles String    @db.Text @map("categorias_descripcion_ingles")

  atracciones AtraccionesCategorias[]
  hoteles     HotelesCategorias[]

  @@map("PZR_categorias")
}

model Contactos {
  id Int       @id @default(autoincrement()) @map("contactos_id")
  valor String    @db.Text @map("contactos_valor")
  tipo String    @db.Text @map("contactos_tipo")
  state String    @default("Active") @db.VarChar(255) @map("contactos_state")
  createdAt DateTime  @default(now()) @db.Timestamp(6) @map("contactos_created_at")
  updateAt DateTime? @db.Timestamp(0) @map("contactos_update_at")

  atracciones          AtraccionesContactos[]
  eventos              EventosContactos[]
  hoteles              HotelesContactos[]
  oficinasTuristicas   OficinasTuristicasContactos[]
  operadoresTuristicos OperadoresTuristicosContactos[]
  rentadorasVehiculos  RentadorasVehiculosContactos[]
  restaurantes         RestaurantesContactos[]

  @@map("PZR_contactos")
}

model Ubicaciones {
  id Int       @id @default(autoincrement()) @map("ubicaciones_id")
  provincia String    @db.Text @map("ubicaciones_provincia")
  canton String    @db.Text @map("ubicaciones_canton")
